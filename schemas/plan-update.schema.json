{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trail-coach.local/schemas/plan-update.schema.json",
  "title": "Trail Coach plan update",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "updateId",
    "basePlanId",
    "basePlanVersion",
    "generatedAt",
    "summary",
    "operations"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "updateId": { "type": "string", "minLength": 1 },
    "basePlanId": { "type": "string", "minLength": 1 },
    "basePlanVersion": { "type": "integer", "minimum": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "operations": {
      "type": "array",
      "maxItems": 30,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "paceTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "minSecPerKm", "maxSecPerKm", "rpeFallback"],
      "properties": {
        "mode": { "const": "pace" },
        "minSecPerKm": { "type": "integer", "minimum": 120, "maximum": 1200 },
        "maxSecPerKm": { "type": "integer", "minimum": 120, "maximum": 1200 },
        "rpeFallback": { "type": "integer", "minimum": 1, "maximum": 5 },
        "terrainNote": { "type": "string", "maxLength": 500 }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "durationMin": { "type": "number", "minimum": 0, "maximum": 600 },
        "distanceKm": { "type": "number", "minimum": 0, "maximum": 100 },
        "repetitions": { "type": "integer", "minimum": 1, "maximum": 100 },
        "paceTarget": { "$ref": "#/$defs/paceTarget" },
        "instructions": { "type": "string", "maxLength": 1500 }
      }
    },
    "workoutPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "type",
        "title",
        "description",
        "rationale",
        "plannedDurationMin",
        "plannedDistanceKm",
        "plannedElevationGainM",
        "segments",
        "source"
      ],
      "properties": {
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "type": {
          "enum": [
            "easy",
            "threshold",
            "intervals",
            "hills",
            "long_run",
            "hike_run",
            "strength",
            "active_recovery",
            "rest"
          ]
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "plannedDurationMin": { "type": "number", "minimum": 0, "maximum": 720 },
        "plannedDistanceKm": { "type": "number", "minimum": 0, "maximum": 100 },
        "plannedElevationGainM": { "type": "number", "minimum": 0, "maximum": 10000 },
        "target": { "$ref": "#/$defs/paceTarget" },
        "segments": {
          "type": "array",
          "maxItems": 30,
          "items": { "$ref": "#/$defs/segment" }
        },
        "source": { "enum": ["rules", "claude"] }
      }
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "workoutId", "newDate", "reason"],
          "properties": {
            "type": { "const": "move_workout" },
            "workoutId": { "type": "string", "minLength": 1 },
            "newDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "reason": { "type": "string", "minLength": 1, "maxLength": 2000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "workoutId", "replacement", "reason"],
          "properties": {
            "type": { "const": "replace_workout" },
            "workoutId": { "type": "string", "minLength": 1 },
            "replacement": { "$ref": "#/$defs/workoutPayload" },
            "reason": { "type": "string", "minLength": 1, "maxLength": 2000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "workoutId", "reason"],
          "properties": {
            "type": { "const": "cancel_workout" },
            "workoutId": { "type": "string", "minLength": 1 },
            "reason": { "type": "string", "minLength": 1, "maxLength": 2000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "workout", "reason"],
          "properties": {
            "type": { "const": "add_workout" },
            "workout": { "$ref": "#/$defs/workoutPayload" },
            "reason": { "type": "string", "minLength": 1, "maxLength": 2000 }
          }
        }
      ]
    }
  }
}
