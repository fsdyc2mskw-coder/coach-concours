{
  "name": "coach-concours-personal",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "sync:swiss-trails": "node scripts/sync-swiss-trails.mjs",
    "sync:swiss-trails:resume": "node scripts/sync-swiss-trails.mjs --geodata-only",
    "check": "npm run validate:repository && npm run validate:schemas && npm run typecheck && npm run test && npm run build",
    "validate:schemas": "node scripts/validate-schemas.mjs",
    "bootstrap": "bash scripts/bootstrap.sh",
    "validate:repository": "node scripts/validate-repository.mjs"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.0.5"
  }
}
